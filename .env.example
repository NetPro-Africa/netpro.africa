# Copy to .env.local (development) or set in the build environment.
# Every variable is inlined at BUILD time: changing one means rebuilding.

# Public site origin used for canonical URLs and the sitemap.
VITE_SITE_ORIGIN=https://netpro.africa

# Where the site is served from on the web server (/ = domain root).
VITE_APP_BASE_PATH=/

# Example for a cPanel subfolder deployment:
# VITE_SITE_ORIGIN=https://example.com
# VITE_APP_BASE_PATH=/netpro/

# NetPro CMS that publishes the site's news. If blank, the landing-page news
# section stays hidden, /news shows "No news yet", and no requests are made.
# The CMS must list https://netpro.africa as an allowed CORS origin.
VITE_NETPRO_API_URL=https://cms.netpro.africa
